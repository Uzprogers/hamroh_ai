# ── Ma'lumotlar bazasi ──
DATABASE_URL=postgres://user@localhost:5432/hamroh_ai

# ── Autentifikatsiya ──
JWT_SECRET=uzun-tasodifiy-satr
JWT_EXPIRES_IN=7d

# ── LLM (OpenAI-mos API) ──
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=

# ── Nutq xizmati ──
# Xizmat akkaunti kalit faylining absolyut yo'li (repoga tushmaydi)
YANDEX_SERVICE_ACCOUNT_KEY_PATH=/absolyut/yol/key.json
YX_FOLDER_ID=
YX_TTS_VOICE=yulduz
YX_STT_LANGUAGE=uz-UZ
YX_TTS_LANGUAGE=uz-UZ
YX_STT_URL=https://stt.api.cloud.yandex.net/speech/v1/stt:recognize
YX_TTS_URL=https://tts.api.cloud.yandex.net/speech/v1/tts:synthesize

# ── Google orqali kirish ──
# Google Cloud Console → OAuth client → Authorized JavaScript origins
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Telegram orqali kirish ──
# @BotFather dan olinadi; bo'sh bo'lsa Telegram tugmasi "sozlanmagan" holatda qoladi
# Username @ belgisisiz yoziladi, masalan: aihamroh_bot
# Server getUpdates bilan tinglaydi — botda webhook o'rnatilgan bo'lmasin
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Avatar ──
AVATAR_PROVIDER=canvas
SIMLI_FACE_ID=
SIMLI_API_KEY=

# ── Server ──
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000,http://localhost:5173
SESSION_INACTIVITY_TIMEOUT_MS=300000
MAX_CONCURRENT_SESSIONS=5
LOG_LEVEL=info
AUDIT_PRIVACY_LEVEL=full
AUDIT_RETENTION_DAYS=30
