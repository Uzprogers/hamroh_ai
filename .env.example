# ── Ma'lumotlar bazasi ──
DATABASE_URL=postgres://user@localhost:5432/hamroh_ai

# ── Autentifikatsiya ──
JWT_SECRET=uzun-tasodifiy-satr
JWT_EXPIRES_IN=7d

# ── LLM ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Yandex SpeechKit ──
# Xizmat akkaunti kalit faylining absolyut yo'li (repoga tushmaydi)
YANDEX_SERVICE_ACCOUNT_KEY_PATH=/absolyut/yol/key.json
YX_FOLDER_ID=
YX_TTS_VOICE=yulduz
YX_STT_LANGUAGE=uz-UZ
YX_TTS_LANGUAGE=uz-UZ
YX_STT_URL=https://stt.api.cloud.yandex.net/speech/v1/stt:recognize
YX_TTS_URL=https://tts.api.cloud.yandex.net/speech/v1/tts:synthesize

# ── Avatar ──
AVATAR_PROVIDER=canvas
SIMLI_FACE_ID=
SIMLI_API_KEY=

# ── Server ──
PORT=3001
NODE_ENV=development
SESSION_INACTIVITY_TIMEOUT_MS=300000
MAX_CONCURRENT_SESSIONS=5
LOG_LEVEL=info
AUDIT_PRIVACY_LEVEL=full
AUDIT_RETENTION_DAYS=30
