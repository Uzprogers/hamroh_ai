# Serverdagi .env fayli uchun namuna: cp deploy/env.prod.example .env

# ── Ma'lumotlar bazasi (docker-compose ichida) ──
POSTGRES_USER=hamroh
POSTGRES_PASSWORD=uzun-tasodifiy-parol
POSTGRES_DB=hamroh
# DATABASE_URL ni docker-compose o'zi beradi, bu yerda yozilmaydi

# ── Domen va portlar ──
PUBLIC_URL=https://aihamroh.uz
WEB_ORIGIN=https://aihamroh.uz,https://www.aihamroh.uz
WEB_PORT=8210
PORT=3001
NODE_ENV=production

# ── Autentifikatsiya ──
JWT_SECRET=uzun-tasodifiy-satr
JWT_EXPIRES_IN=7d

# ── LLM ──
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Nutq xizmati ──
# Kalit fayl serverda turadi, konteynerga read-only ulanadi
YANDEX_KEY_PATH=/srv/hamroh/secrets/key.json
YX_FOLDER_ID=
YX_TTS_VOICE=yulduz
YX_STT_LANGUAGE=uz-UZ
YX_TTS_LANGUAGE=uz-UZ

# ── Google orqali kirish ──
GOOGLE_CLIENT_ID=

# ── Telegram orqali kirish ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Avatar ──
AVATAR_PROVIDER=simli
SIMLI_API_KEY=
SIMLI_FACE_ID=cace3ef7-a4c4-425d-a8cf-a5358eb0c427

# ── Seed ──
# Ustoz akkauntiga parol qo'yish uchun (ixtiyoriy)
SEED_TEACHER_PASSWORD=
